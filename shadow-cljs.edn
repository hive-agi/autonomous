;; Builds for the adapter tests, the headless example runtime and the
;; browser example. Run embedded from a REPL on the :cljs alias, or with
;; `npx shadow-cljs` (deps come from deps.edn :cljs).
{:deps {:aliases [:cljs]}

 ;; `bb demo` moves the ports through the environment (SHADOW_CLJS
 ;; deep-merges scalars but would add a second :dev-http entry, so the
 ;; dev-http port is read here). :use-index-files serves index.html at `/`.
 :nrepl {:port 7888}

 :dev-http {#shadow/env ["AUTONOMOUS_DEV_HTTP_PORT" :as :int :default 8280]
            {:root "example/public" :use-index-files true}}

 :builds
 {:test {:target    :node-test
         :output-to "target/cljs-test/test.js"
         :ns-regexp "-test$"
         :autorun   false}

  ;; Needs the :cljs-rf2 classpath (real re-frame2); see deps.edn.
  :rf2-test {:target    :node-test
             :output-to "target/cljs-rf2-test/test.js"
             :ns-regexp "-rf2-test$"
             :autorun   false}

  :e2e  {:target    :node-script
         :main      todo.node/main
         :output-to "target/e2e/main.js"}

  :app  {:target     :browser
         :output-dir "example/public/js"
         :asset-path "/js"
         :modules    {:main {:init-fn todo.browser/init}}}

  ;; The runtime for non-ClojureScript web apps, as an ES module
  ;; (autonomous.js): `import * as autonomous from './autonomous.js'`.
  :js   {:target     :esm
         :output-dir "target/autonomous-js"
         :modules    {:autonomous {:exports {setApp         autonomous.js/setApp
                                             registerTool   autonomous.js/registerTool
                                             unregisterTool autonomous.js/unregisterTool
                                             journal        autonomous.js/journal
                                             connect        autonomous.js/connect}}}}}}
