{:paths ["src"]

 ;; Versions match the root deps.edn pins.
 :deps
 {io.github.hive-agi/autonomous {:mvn/version "0.2.2"}
  org.clojure/data.json         {:mvn/version "2.5.2"}
  nrepl/nrepl                   {:mvn/version "1.3.1"}
  clj-commons/clj-yaml          {:mvn/version "1.0.29"}}

 :aliases
 {;; clojure -T:build <task>, as at the repo root.
  :build {:deps {io.github.hive-agi/hive-build {:mvn/version "0.3.3"}}
          :jvm-opts ["-Xmx1g"]
          :ns-default hive-build.api}

  :test
  {:extra-paths ["test"]
   :extra-deps {lambdaisland/kaocha {:mvn/version "1.91.1392"}}
   :main-opts ["-m" "kaocha.runner"]}}}
