{:paths ["src" "resources"]

 ;; The hive integration of autonomous: an IAddon for hive-mcp. The core
 ;; library never depends on hive; this module does. Developing both at once,
 ;; a gitignored local.deps.edn points autonomous at the local checkout.
 :deps
 {io.github.hive-agi/autonomous {:mvn/version "0.1.3"}
  io.github.hive-agi/hive-addon {:mvn/version "1.1.10"}
  io.github.hive-agi/hive-system {:mvn/version "0.4.5"}}

 :aliases
 {:test
  {:extra-paths ["test"]
   :extra-deps {lambdaisland/kaocha          {:mvn/version "1.91.1392"}
                org.clojure/test.check       {:mvn/version "1.1.3"}
                io.github.hive-agi/hive-test {:mvn/version "0.5.2"}}
   :main-opts ["-m" "kaocha.runner"]}

  :nrepl
  {:extra-deps {cider/cider-nrepl {:mvn/version "0.58.0"}}}}}
