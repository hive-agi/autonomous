;; libautonomous: the autonomous runtime as a C library, built with jolt.
;;   cd cabi && jolt build --library -m autonomous.cabi -o build/libautonomous
;; or from the repo root: bb cabi
;; jolt-lang/time provides java.time.format (RFC 0014), which malli.transform
;; and data.json touch at load.
{:paths ["src" "../src"]
 :deps  {metosin/malli            {:mvn/version "0.20.3"}
         org.clojure/data.json    {:mvn/version "2.5.2"}
         io.github.jolt-lang/time {:git/url "https://github.com/jolt-lang/time"
                                   :git/tag "v0.0.9" :git/sha "abeee49"}}}
